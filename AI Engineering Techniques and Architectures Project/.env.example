# Copy to .env (never commit .env). All variables are optional: without an LLM key the
# agent falls back to a deterministic planner + extractive answer synthesis.
# Any OpenAI-compatible provider works. OpenRouter (key from https://openrouter.ai/keys):
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o
# Groq alternative (key from https://console.groq.com/keys):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
# MCP transport: leave MCP_SERVER_URL empty to spawn the MCP server as a stdio subprocess.
# Set it (e.g. http://localhost:8001/mcp) to call a separately deployed MCP service.
MCP_SERVER_URL=
# Fixed "today" for reproducible demos/evals (YYYY-MM-DD). Empty = real date.
APP_TODAY=
